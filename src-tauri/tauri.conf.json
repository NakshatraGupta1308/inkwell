{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwell",
  "version": "0.1.0",
  "identifier": "app.inkwell.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Inkwell",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["ink"],
        "name": "Inkwell note",
        "description": "Inkwell note (plain markdown)",
        "role": "Editor"
      }
    ]
  }
}
